<script>
/* =========================================================
   凡哥主题空间 · 小游戏厅
   单文件实现：外壳（选游戏 / 启动 / 存档）+ 7 款内置小游戏
   ========================================================= */
(function () {
  'use strict';

  /* ---------- 小工具 ---------- */
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  function html(str) {
    var t = document.createElement('template');
    t.innerHTML = String(str).trim();
    return t.content.firstElementChild;
  }
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
  function rand(n) { return Math.floor(Math.random() * n); }
  function pad(n) { return (n < 10 ? '0' : '') + n; }

  /* ---------- 音效 ---------- */
  var actx = null;
  var SFX = {
    click: [520, .06, 'triangle'], eat: [880, .08, 'square'], hit: [200, .08, 'sawtooth'],
    flip: [440, .05, 'sine'], flag: [300, .05, 'sine'], good: [740, .12, 'triangle'],
    win: [660, .22, 'triangle'], lose: [180, .30, 'sawtooth'], boom: [110, .22, 'square']
  };
  function sfx(kind) {
    if (store.data.muted) return;
    try {
      var AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      actx = actx || new AC();
      if (actx.state === 'suspended') actx.resume();
      var cfg = SFX[kind] || SFX.click;
      var t = actx.currentTime, d = cfg[1];
      var o = actx.createOscillator(), g = actx.createGain();
      o.type = cfg[2];
      o.frequency.setValueAtTime(cfg[0], t);
      if (kind === 'win' || kind === 'good') o.frequency.exponentialRampToValueAtTime(cfg[0] * 1.9, t + d);
      if (kind === 'lose' || kind === 'boom') o.frequency.exponentialRampToValueAtTime(Math.max(60, cfg[0] / 2.2), t + d);
      g.gain.setValueAtTime(.0001, t);
      g.gain.exponentialRampToValueAtTime(.09, t + .012);
      g.gain.exponentialRampToValueAtTime(.0001, t + d);
      o.connect(g); g.connect(actx.destination);
      o.start(t); o.stop(t + d + .03);
    } catch (e) { /* 音效失败不影响游戏 */ }
  }

  /* ---------- 存档 ---------- */
  var store = {
    key: 'fange-space-v1',
    data: { bests: {}, muted: false, plays: 0 },
    load: function () {
      try {
        var raw = JSON.parse(localStorage.getItem(this.key) || '{}');
        if (raw && typeof raw === 'object') {
          if (raw.bests) this.data.bests = raw.bests;
          this.data.muted = !!raw.muted;
          this.data.plays = raw.plays || 0;
        }
      } catch (e) { }
    },
    save: function () { try { localStorage.setItem(this.key, JSON.stringify(this.data)); } catch (e) { } }
  };
  store.load();

  /* ---------- 提示条 ---------- */
  function toast(msg) {
    var t = html('<div class="toast">' + msg + '</div>');
    document.body.appendChild(t);
    setTimeout(function () {
      t.classList.add('out');
      setTimeout(function () { t.remove(); }, 400);
    }, 2200);
  }

  /* ---------- 清理器：退出游戏时回收所有监听器 / 定时器 ---------- */
  function Cleaner() { this.fns = []; this.done = false; }
  Cleaner.prototype.add = function (fn) {
    if (typeof fn !== 'function') return;
    if (this.done) { try { fn(); } catch (e) { } return; }
    this.fns.push(fn);
  };
  Cleaner.prototype.run = function () {
    this.done = true;
    this.fns.splice(0).reverse().forEach(function (f) { try { f(); } catch (e) { } });
  };

  /* =========================================================
     游戏 1：贪吃蛇
     ========================================================= */
  var G_SNAKE = {
    id: 'snake', name: '贪吃蛇', emoji: '🐍', cat: '街机', diff: 2,
    desc: '吃果子变长，别撞墙也别咬到自己。每吃一个都快一点。',
    better: 'high', fmt: function (v) { return v + ' 分'; },
    mount: function (root, api) {
      var G = 20, C = 24, W = G * C;
      root.innerHTML =
        '<div class="hud">' +
        '<span class="hud-item">得分<b data-score>0</b></span>' +
        '<span class="hud-item">长度<b data-len>3</b></span>' +
        '<span class="hud-item">速度<b data-spd>1.0x</b></span>' +
        '</div>' +
        '<div class="cv-wrap"><canvas class="cv" data-cv width="' + W + '" height="' + W + '"></canvas></div>' +
        '<div class="dpad">' +
        '<button data-dir="up" aria-label="上">▲</button>' +
        '<button data-dir="left" aria-label="左">◀</button>' +
        '<button data-dir="down" aria-label="下">▼</button>' +
        '<button data-dir="right" aria-label="右">▶</button>' +
        '</div>' +
        '<p class="tip">方向键 / WASD 控制，手机可用方向键或直接在画面上滑动。</p>';

      var cv = $('[data-cv]', root), ctx = cv.getContext('2d');
      var scoreEl = $('[data-score]', root), lenEl = $('[data-len]', root), spdEl = $('[data-spd]', root);
      var snake, dir, nextDir, food, score, step, acc, alive, started;

      function spawnFood() {
        var free = [], i;
        for (var y = 0; y < G; y++) for (var x = 0; x < G; x++) {
          var hit = false;
          for (i = 0; i < snake.length; i++) if (snake[i].x === x && snake[i].y === y) { hit = true; break; }
          if (!hit) free.push({ x: x, y: y });
        }
        return free.length ? free[rand(free.length)] : { x: 0, y: 0 };
      }
      function sync() {
        scoreEl.textContent = score;
        lenEl.textContent = snake.length;
        spdEl.textContent = (115 / step).toFixed(1) + 'x';
      }
      function reset() {
        snake = [{ x: 9, y: 10 }, { x: 8, y: 10 }, { x: 7, y: 10 }];
        dir = { x: 1, y: 0 }; nextDir = { x: 1, y: 0 };
        score = 0; step = 115; acc = 0; alive = true; started = false;
        food = spawnFood(); sync();
      }
      function turn(nx, ny) {
        if (!alive) return;
        started = true;
        if (nx === -dir.x && ny === -dir.y) return;
        nextDir = { x: nx, y: ny };
      }
      function tick() {
        dir = nextDir;
        var head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
        if (head.x < 0 || head.y < 0 || head.x >= G || head.y >= G) return die();
        for (var i = 0; i < snake.length - 1; i++) {
          if (snake[i].x === head.x && snake[i].y === head.y) return die();
        }
        snake.unshift(head);
        if (head.x === food.x && head.y === food.y) {
          score += 10; sfx('eat');
          if (step > 58) step -= 3;
          food = spawnFood();
        } else snake.pop();
        sync();
      }
      function die() {
        alive = false; sfx('lose');
        api.submit(score);
        api.gameOver({
          title: '💥 撞上了',
          sub: '本局得分 <b>' + score + '</b><br>蛇长 ' + snake.length + ' 节',
          onRestart: reset
        });
      }
      function draw() {
        ctx.fillStyle = '#070a14';
        ctx.fillRect(0, 0, W, W);
        ctx.strokeStyle = 'rgba(255,255,255,.045)';
        ctx.lineWidth = 1;
        for (var i = 1; i < G; i++) {
          ctx.beginPath(); ctx.moveTo(i * C, 0); ctx.lineTo(i * C, W); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(0, i * C); ctx.lineTo(W, i * C); ctx.stroke();
        }
        // 果子
        var fx = food.x * C + C / 2, fy = food.y * C + C / 2;
        ctx.save();
        ctx.shadowColor = 'rgba(255,122,24,.9)'; ctx.shadowBlur = 18;
        ctx.fillStyle = '#ff7a18';
        ctx.beginPath(); ctx.arc(fx, fy, C * .33, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
        // 蛇身
        for (var s = snake.length - 1; s >= 0; s--) {
          var seg = snake[s];
          var p = 1 - s / Math.max(snake.length, 1);
          ctx.fillStyle = s === 0
            ? '#5eead4'
            : 'rgba(' + Math.round(56 + 60 * p) + ',' + Math.round(189 + 30 * p) + ',248,' + (0.42 + 0.5 * p) + ')';
          var x = seg.x * C + 2, y = seg.y * C + 2, w = C - 4;
          var r = s === 0 ? 9 : 7;
          ctx.beginPath();
          ctx.moveTo(x + r, y);
          ctx.arcTo(x + w, y, x + w, y + w, r);
          ctx.arcTo(x + w, y + w, x, y + w, r);
          ctx.arcTo(x, y + w, x, y, r);
          ctx.arcTo(x, y, x + w, y, r);
          ctx.closePath(); ctx.fill();
        }
        if (!started) {
          ctx.fillStyle = 'rgba(0,0,0,.62)'; ctx.fillRect(0, W / 2 - 56, W, 112);
          ctx.fillStyle = '#e9edf8'; ctx.font = 'bold 26px sans-serif'; ctx.textAlign = 'center';
          ctx.fillText('按方向键开始', W / 2, W / 2 + 2);
          ctx.fillStyle = '#8a93ab'; ctx.font = '15px sans-serif';
          ctx.fillText('别撞墙，别咬自己', W / 2, W / 2 + 32);
        }
      }

      api.on(document, 'keydown', function (e) {
        var k = e.key.toLowerCase();
        if (k.indexOf('arrow') === 0 || k === ' ') e.preventDefault();
        if (k === 'arrowup' || k === 'w') turn(0, -1);
        else if (k === 'arrowdown' || k === 's') turn(0, 1);
        else if (k === 'arrowleft' || k === 'a') turn(-1, 0);
        else if (k === 'arrowright' || k === 'd') turn(1, 0);
      });
      $$('.dpad button', root).forEach(function (b) {
        api.on(b, 'click', function () {
          var d = b.getAttribute('data-dir');
          sfx('click');
          if (d === 'up') turn(0, -1); else if (d === 'down') turn(0, 1);
          else if (d === 'left') turn(-1, 0); else turn(1, 0);
        });
      });
      var ts = null;
      api.on(cv, 'touchstart', function (e) { ts = e.touches[0]; }, { passive: true });
      api.on(cv, 'touchend', function (e) {
        if (!ts) return;
        var t = e.changedTouches[0], dx = t.clientX - ts.clientX, dy = t.clientY - ts.clientY;
        if (Math.abs(dx) < 14 && Math.abs(dy) < 14) return;
        if (Math.abs(dx) > Math.abs(dy)) turn(dx > 0 ? 1 : -1, 0); else turn(0, dy > 0 ? 1 : -1);
      }, { passive: true });

      reset();
      api.loop(function (dt) {
        if (alive) {
          if (started) {
            acc += dt;
            while (acc >= step && alive) { acc -= step; tick(); }
          }
        }
        draw();
      });
    }
  };

  /* =========================================================
     游戏 2：打砖块
     ========================================================= */
  var G_BREAK = {
    id: 'breakout', name: '打砖块', emoji: '🧱', cat: '街机', diff: 2,
    desc: '挡板接球，把整面板砖敲光。球速会随着波次越来越快。',
    better: 'high', fmt: function (v) { return v + ' 分'; },
    mount: function (root, api) {
      var W = 520, H = 520, PAD = 20, TOP = 64, COLS = 9, ROWS = 5, GAP = 6;
      root.innerHTML =
        '<div class="hud">' +
        '<span class="hud-item">得分<b data-score>0</b></span>' +
        '<span class="hud-item">生命<b data-lives>❤❤❤</b></span>' +
        '<span class="hud-item">波次<b data-wave>1</b></span>' +
        '</div>' +
        '<div class="cv-wrap"><canvas class="cv" data-cv width="' + W + '" height="' + H + '"></canvas></div>' +
        '<p class="tip">移动鼠标 / 手指在画面上滑动，或按 ← → 控制挡板。</p>';

      var cv = $('[data-cv]', root), ctx = cv.getContext('2d');
      var scoreEl = $('[data-score]', root), livesEl = $('[data-lives]', root), waveEl = $('[data-wave]', root);
      var bw = (W - PAD * 2 - GAP * (COLS - 1)) / COLS, bh = 20;
      var paddle, ball, bricks, score, lives, wave, waiting, waitT, over, decay;

      function buildWave() {
        bricks = [];
        for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) {
          bricks.push({
            x: PAD + c * (bw + GAP), y: TOP + r * (bh + GAP),
            w: bw, h: bh, alive: true, hp: r === 0 ? 2 : 1, row: r
          });
        }
      }
      function serve() {
        waiting = true; waitT = 700;
        ball.x = paddle.x + paddle.w / 2; ball.y = paddle.y - 14;
        ball.vx = 0; ball.vy = 0;
      }
      function launch() {
        if (!waiting) return;
        waiting = false;
        var sp = 4.6 + wave * .38;
        var ang = (-60 + rand(120)) * Math.PI / 180;
        ball.vx = Math.sin(ang) * sp;
        ball.vy = -Math.abs(Math.cos(ang) * sp);
      }
      function reset() {
        paddle = { x: W / 2 - 48, y: H - 34, w: 96, h: 12 };
        ball = { x: W / 2, y: H - 50, vx: 0, vy: 0, r: 7 };
        score = 0; lives = 3; wave = 1; over = false; decay = 0;
        buildWave(); serve(); sync();
      }
      function sync() {
        scoreEl.textContent = score;
        livesEl.textContent = lives > 0 ? new Array(lives + 1).join('❤') : '—';
        waveEl.textContent = wave;
      }
      function endMatch() {
        over = true; sfx('lose'); api.submit(score);
        api.gameOver({
          title: '🏁 打完了',
          sub: '最终得分 <b>' + score + '</b><br>坚持到第 ' + wave + ' 波',
          onRestart: reset
        });
      }
      function loseLife() {
        lives--; sfx('hit'); sync();
        if (lives <= 0) return endMatch();
        serve();
      }
      function hitBrick(b) {
        if (b.hp > 1) { b.hp--; b.crack = true; score += 5; }
        else b.alive = false;
        score += 10 + (ROWS - b.row) * 2;
        sfx('eat'); sync();
        if (!bricks.some(function (k) { return k.alive; })) {
          wave++; score += 100; sfx('good');
          buildWave(); serve(); sync();
        }
      }
      function movePaddleTo(clientX) {
        var rect = cv.getBoundingClientRect();
        var x = (clientX - rect.left) / rect.width * W;
        paddle.x = clamp(x - paddle.w / 2, 0, W - paddle.w);
      }
      api.on(cv, 'mousemove', function (e) { movePaddleTo(e.clientX); });
      api.on(cv, 'touchmove', function (e) { e.preventDefault(); movePaddleTo(e.touches[0].clientX); }, { passive: false });
