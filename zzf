        ball.vy = Math.sin(ang) * ball.sp;
      }
      function point(who) {
        if (who === 'me') { me.score++; sfx('good'); } else { ai.score++; sfx('hit'); }
        sync();
        if (me.score >= TARGET || ai.score >= TARGET) {
          over = true;
          var win = me.score >= TARGET;
          if (win) sfx('win'); else sfx('lose');
          api.submit(me.score);
          api.gameOver({
            title: win ? '🏆 凡哥赢了' : '😤 电脑赢了',
            sub: '比分 <b>' + me.score + ' : ' + ai.score + '</b>',
            onRestart: reset
          });
          return;
        }
        serve(who !== 'me');
      }
      function movePaddle(clientY) {
        var rect = cv.getBoundingClientRect();
        var y = (clientY - rect.top) / rect.height * H;
        me.y = clamp(y - PH / 2, 0, H - PH);
      }
      api.on(cv, 'mousemove', function (e) { movePaddle(e.clientY); });
      api.on(cv, 'touchmove', function (e) { e.preventDefault(); movePaddle(e.touches[0].clientY); }, { passive: false });
      api.on(document, 'keydown', function (e) {
        var k = e.key.toLowerCase();
        if (k === 'arrowup' || k === 'w') { up = true; e.preventDefault(); }
        if (k === 'arrowdown' || k === 's') { down = true; e.preventDefault(); }
      });
      api.on(document, 'keyup', function (e) {
        var k = e.key.toLowerCase();
        if (k === 'arrowup' || k === 'w') up = false;
        if (k === 'arrowdown' || k === 's') down = false;
      });

      function step(dt) {
        if (over) return;
        var k = dt / 16.67;
        if (up) me.y = clamp(me.y - 8 * k, 0, H - PH);
        if (down) me.y = clamp(me.y + 8 * k, 0, H - PH);
        // 电脑：追踪球，带点迟钝
        var target = ball.vx > 0 ? ball.y - PH / 2 : H / 2 - PH / 2;
        var diff = target - ai.y;
        ai.y = clamp(ai.y + clamp(diff, -5.4 * k, 5.4 * k), 0, H - PH);

        if (waitT > 0) { waitT -= dt; if (waitT <= 0) launch(); return; }
        ball.x += ball.vx * k; ball.y += ball.vy * k;
        if (ball.y - ball.r < 0) { ball.y = ball.r; ball.vy = Math.abs(ball.vy); sfx('click'); }
        if (ball.y + ball.r > H) { ball.y = H - ball.r; ball.vy = -Math.abs(ball.vy); sfx('click'); }
        if (ball.vx < 0 && ball.x - ball.r <= 24 + PW && ball.x + ball.r >= 24 &&
            ball.y + ball.r > me.y && ball.y - ball.r < me.y + PH) {
          ball.x = 24 + PW + ball.r;
          ball.sp = Math.min(ball.sp * 1.06, 14);
          var rel = clamp((ball.y - (me.y + PH / 2)) / (PH / 2), -1, 1);
          ball.vx = Math.abs(ball.sp * Math.cos(rel * .9));
          ball.vy = ball.sp * Math.sin(rel * .9);
          sfx('hit');
        }
        if (ball.vx > 0 && ball.x + ball.r >= W - 24 - PW && ball.x - ball.r <= W - 24 &&
            ball.y + ball.r > ai.y && ball.y - ball.r < ai.y + PH) {
          ball.x = W - 24 - PW - ball.r;
          ball.sp = Math.min(ball.sp * 1.06, 14);
          var rel2 = clamp((ball.y - (ai.y + PH / 2)) / (PH / 2), -1, 1);
          ball.vx = -Math.abs(ball.sp * Math.cos(rel2 * .9));
          ball.vy = ball.sp * Math.sin(rel2 * .9);
          sfx('hit');
        }
        if (ball.x < -20) point('ai');
        else if (ball.x > W + 20) point('me');
      }
      function draw() {
        ctx.fillStyle = '#070a14'; ctx.fillRect(0, 0, W, H);
        ctx.strokeStyle = 'rgba(255,255,255,.14)'; ctx.lineWidth = 2;
        ctx.setLineDash([9, 12]);
        ctx.beginPath(); ctx.moveTo(W / 2, 0); ctx.lineTo(W / 2, H); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = 'rgba(255,255,255,.09)'; ctx.font = 'bold 92px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(me.score, W / 2 - 90, 104);
        ctx.fillText(ai.score, W / 2 + 90, 104);
        ctx.save();
        ctx.shadowColor = 'rgba(255,122,24,.9)'; ctx.shadowBlur = 18;
        ctx.fillStyle = '#ff7a18';
        ctx.fillRect(24, me.y, PW, PH);
        ctx.restore();
        ctx.save();
        ctx.shadowColor = 'rgba(56,189,248,.9)'; ctx.shadowBlur = 18;
        ctx.fillStyle = '#38bdf8';
        ctx.fillRect(W - 24 - PW, ai.y, PW, PH);
        ctx.restore();
        ctx.save();
        ctx.shadowColor = 'rgba(233,237,248,.9)'; ctx.shadowBlur = 16;
        ctx.fillStyle = '#e9edf8';
        ctx.beginPath(); ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      }
      reset();
      api.loop(function (dt) { step(dt); draw(); });
    }
  };

  /* =========================================================
     游戏 7：躲避陨石
     ========================================================= */
  var G_DODGE = {
    id: 'dodge', name: '躲避陨石', emoji: '🚀', cat: '反应', diff: 2,
    desc: '驾驶飞船穿流星带，活得越久分越高。三条命，撞三次就结束。',
    better: 'high', fmt: function (v) { return v + ' 分'; },
    mount: function (root, api) {
      var W = 520, H = 520;
      root.innerHTML =
        '<div class="hud">' +
        '<span class="hud-item">得分<b data-score>0</b></span>' +
        '<span class="hud-item">生命<b data-lives>❤❤❤</b></span>' +
        '<span class="hud-item">难度<b data-lv>1</b></span>' +
        '</div>' +
        '<div class="cv-wrap"><canvas class="cv" data-cv width="' + W + '" height="' + H + '"></canvas></div>' +
        '<p class="tip">鼠标 / 手指左右滑动，或用 ← → / A D 控制飞船。</p>';

      var cv = $('[data-cv]', root), ctx = cv.getContext('2d');
      var scoreEl = $('[data-score]', root), livesEl = $('[data-lives]', root), lvEl = $('[data-lv]', root);
      var stars, rocks, ship, score, lives, alive, spawnT, t, invuln, level;

      function reset() {
        ship = { x: W / 2, y: H - 52, w: 30, h: 34 };
        rocks = []; score = 0; lives = 3; alive = true; spawnT = 400; t = 0; invuln = 0; level = 1;
        stars = [];
        for (var i = 0; i < 70; i++) stars.push({ x: rand(W), y: rand(H), r: Math.random() * 1.6 + .4, s: Math.random() * 1.6 + .5 });
        sync();
      }
      function sync() {
        scoreEl.textContent = score;
        livesEl.textContent = lives > 0 ? new Array(lives + 1).join('❤') : '—';
        lvEl.textContent = level;
      }
      function hurt() {
        if (invuln > 0 || !alive) return;
        lives--; invuln = 1400; sfx('boom'); sync();
        if (lives <= 0) {
          alive = false;
          api.submit(score);
          api.gameOver({
            title: '☄️ 飞船报废',
            sub: '坚持了 <b>' + (t / 1000).toFixed(1) + ' 秒</b><br>得分 ' + score,
            onRestart: reset
          });
        }
      }
      function moveShip(clientX) {
        var rect = cv.getBoundingClientRect();
        var x = (clientX - rect.left) / rect.width * W;
        ship.x = clamp(x, ship.w / 2, W - ship.w / 2);
      }
      api.on(cv, 'mousemove', function (e) { moveShip(e.clientX); });
      api.on(cv, 'touchmove', function (e) { e.preventDefault(); moveShip(e.touches[0].clientX); }, { passive: false });
      api.on(cv, 'touchstart', function (e) { moveShip(e.touches[0].clientX); }, { passive: true });
      var left = false, right = false;
      api.on(document, 'keydown', function (e) {
        var k = e.key.toLowerCase();
        if (k === 'arrowleft' || k === 'a') { left = true; e.preventDefault(); }
        if (k === 'arrowright' || k === 'd') { right = true; e.preventDefault(); }
      });
      api.on(document, 'keyup', function (e) {
        var k = e.key.toLowerCase();
        if (k === 'arrowleft' || k === 'a') left = false;
        if (k === 'arrowright' || k === 'd') right = false;
      });

      function step(dt) {
        if (!alive) return;
        t += dt;
        score = Math.floor(t / 100) * 2 + Math.floor(t / 3000) * 10;
        level = 1 + Math.floor(t / 12000);
        if (invuln > 0) invuln -= dt;
        if (left) ship.x = clamp(ship.x - 8 * (dt / 16.67), ship.w / 2, W - ship.w / 2);
        if (right) ship.x = clamp(ship.x + 8 * (dt / 16.67), ship.w / 2, W - ship.w / 2);
        for (var i = 0; i < stars.length; i++) {
          stars[i].y += stars[i].s * (1 + level * .3) * (dt / 16.67);
          if (stars[i].y > H) { stars[i].y = -4; stars[i].x = rand(W); }
        }
        spawnT -= dt;
        if (spawnT <= 0) {
          spawnT = Math.max(150, 520 - level * 45) + rand(260);
          var r = 10 + Math.random() * 18;
          rocks.push({
            x: r + Math.random() * (W - r * 2), y: -r,
            r: r, vy: (1.7 + Math.random() * 1.5) * (1 + level * .16),
            vx: (Math.random() - .5) * .9, rot: Math.random() * 6.28, rv: (Math.random() - .5) * .06
          });
        }
        for (i = rocks.length - 1; i >= 0; i--) {
          var k = rocks[i];
          k.y += k.vy * (dt / 16.67); k.x += k.vx * (dt / 16.67); k.rot += k.rv * (dt / 16.67);
          var hx = clamp(k.x, ship.x - ship.w / 2, ship.x + ship.w / 2);
          var hy = clamp(k.y, ship.y - ship.h / 2, ship.y + ship.h / 2);
          var dx = k.x - hx, dy = k.y - hy;
          if (dx * dx + dy * dy < k.r * k.r * .82) {
            rocks.splice(i, 1); hurt(); continue;
          }
          if (k.y - k.r > H + 30) { rocks.splice(i, 1); score += 5; }
        }
        sync();
      }
      function draw() {
        ctx.fillStyle = '#05070f'; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = 'rgba(255,255,255,.55)';
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          ctx.globalAlpha = .25 + s.r / 2.4;
          ctx.fillRect(s.x, s.y, s.r, s.r * 2.2);
        }
        ctx.globalAlpha = 1;
        for (i = 0; i < rocks.length; i++) {
          var k = rocks[i];
          ctx.save();
          ctx.translate(k.x, k.y); ctx.rotate(k.rot);
          var g = ctx.createRadialGradient(-k.r * .3, -k.r * .3, k.r * .2, 0, 0, k.r);
          g.addColorStop(0, '#a1a1aa'); g.addColorStop(.6, '#52525b'); g.addColorStop(1, '#27272a');
          ctx.fillStyle = g;
          ctx.beginPath();
          for (var a = 0; a < 8; a++) {
            var ang = a / 8 * Math.PI * 2, rr = k.r * (.78 + ((a * 37) % 10) / 42);
            if (a === 0) ctx.moveTo(Math.cos(ang) * rr, Math.sin(ang) * rr);
            else ctx.lineTo(Math.cos(ang) * rr, Math.sin(ang) * rr);
          }
          ctx.closePath(); ctx.fill();
          ctx.restore();
        }
        if (alive) {
          var blink = invuln > 0 && Math.floor(invuln / 130) % 2 === 0;
          ctx.save();
          ctx.globalAlpha = blink ? .3 : 1;
          ctx.translate(ship.x, ship.y);
          ctx.shadowColor = 'rgba(56,189,248,.95)'; ctx.shadowBlur = 20;
          ctx.fillStyle = '#38bdf8';
          ctx.beginPath();
          ctx.moveTo(0, -ship.h / 2);
          ctx.lineTo(ship.w / 2, ship.h / 2);
          ctx.lineTo(0, ship.h / 2 - 9);
          ctx.lineTo(-ship.w / 2, ship.h / 2);
          ctx.closePath(); ctx.fill();
          ctx.shadowColor = 'rgba(255,122,24,.95)';
          ctx.fillStyle = '#ff7a18';
          ctx.beginPath();
          ctx.moveTo(-5, ship.h / 2 - 4); ctx.lineTo(5, ship.h / 2 - 4); ctx.lineTo(0, ship.h / 2 + 10 + rand(7));
          ctx.closePath(); ctx.fill();
          ctx.restore();
        }
      }
      reset();
      api.loop(function (dt) { step(dt); draw(); });
    }
  };

  var GAMES = [G_SNAKE, G_BREAK, G_2048, G_MEM, G_MINE, G_PONG, G_DODGE];
  var CATS = ['全部', '街机', '益智', '反应'];

  /* =========================================================
     启动舞台
     ========================================================= */
  var stage = $('#stage'), stageBody = $('#stageBody'), stageTitle = $('#stageTitle'), stageBest = $('#stageBest');
  var current = null;

  function fmtBest(g) {
    var v = store.data.bests[g.id];
    return (v === undefined || v === null) ? null : g.fmt(v);
  }
  function bestLabel(g) {
    var t = fmtBest(g);
    return t === null ? '最高记录：暂无' : '最高记录：<b>' + t + '</b>';
  }
  function openGame(g) {
    if (current) closeGame(true);
    store.data.plays++; store.save();
    stage.hidden = false;
    document.body.classList.add('locked');
    stageTitle.textContent = g.emoji + ' ' + g.name;
    stageBest.innerHTML = bestLabel(g);
    stageBody.textContent = '';

    var cleaner = new Cleaner();
    current = { game: g, cleaner: cleaner };
    sfx('click');

    var boot = html(
      '<div class="boot"><div class="boot-logo">' + g.emoji + '</div>' +
      '<div class="boot-text">正在启动 ' + g.name + '…</div>' +
      '<div class="boot-bar"><i></i></div></div>'
    );
    stageBody.appendChild(boot);

    var api = {
      on: function (target, type, fn, opts) {
        target.addEventListener(type, fn, opts);
        cleaner.add(function () { target.removeEventListener(type, fn, opts); });
      },
      loop: function (fn) {
        var last = performance.now(), raf = 0, run = true;
        function frame(now) {
          if (!run) return;
          var dt = Math.min(60, now - last);
          last = now;
          try { fn(dt, now); } catch (err) { console.error(err); }
          raf = requestAnimationFrame(frame);
        }
        raf = requestAnimationFrame(frame);
        cleaner.add(function () { run = false; cancelAnimationFrame(raf); });
      },
      timeout: function (fn, ms) {
        var id = setTimeout(fn, ms);
        cleaner.add(function () { clearTimeout(id); });
        return id;
      },
      submit: function (score) {
        if (typeof score !== 'number' || !isFinite(score)) return false;
        var prev = store.data.bests[g.id];
        var better = (prev === undefined || prev === null) ||
          (g.better === 'low' ? score < prev : score > prev);
        if (better) {
          store.data.bests[g.id] = score;
          store.save();
          refreshCard(g.id);
          renderStats();
          renderRecords();
        }
        stageBest.innerHTML = bestLabel(g);
        return better;
      },
      gameOver: function (opt) {
        var node = html(
          '<div class="gover"><div class="gover-card">' +
          '<h3>' + opt.title + '</h3>' +
          '<p>' + opt.sub + '</p>' +
          '<div class="gover-actions">' +
          '<button class="btn primary" data-again>再来一局</button>' +
          '<button class="btn ghost" data-exit>返回大厅</button>' +
          '</div></div></div>'
        );
        $('[data-again]', node).addEventListener('click', function () {
          sfx('click'); node.remove(); opt.onRestart();
        });
        $('[data-exit]', node).addEventListener('click', function () { sfx('click'); closeGame(); });
        document.body.appendChild(node);
        cleaner.add(function () { node.remove(); });
      },
      close: function () { closeGame(); }
    };

    cleaner.add(function () { stageBody.textContent = ''; });

    api.timeout(function () {
      boot.remove();
      var wrap = html('<div class="game"></div>');
      stageBody.appendChild(wrap);
      try { g.mount(wrap, api); }
      catch (err) {
        console.error(err);
        wrap.innerHTML = '<p class="tip">这个游戏启动失败了：' + (err && err.message ? err.message : err) + '</p>';
      }
    }, 520);
  }

  function closeGame(silent) {
    if (!current) return;
    var c = current;
    current = null;
    c.cleaner.run();
    stage.hidden = true;
    document.body.classList.remove('locked');
    if (!silent) sfx('click');
    renderStats();
  }

  $('#stageClose').addEventListener('click', function () { closeGame(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && current) closeGame();
  });

  /* =========================================================
     游戏墙
     ========================================================= */
  var gridEl = $('#gameGrid'), filtersEl = $('#filters');
  var activeCat = '全部';

  function stars(n) { return '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n); }

  function cardHTML(g) {
    var v = fmtBest(g);
    return '<article class="card" data-card="' + g.id + '">' +
      '<div class="card-top"><span class="card-emoji">' + g.emoji + '</span>' +
      '<div><div class="card-name">' + g.name + '</div>' +
      '<div class="card-cat">' + g.cat + ' · <span class="stars">' + stars(g.diff) + '</span></div></div></div>' +
      '<p class="card-desc">' + g.desc + '</p>' +
      '<div class="card-foot">' +
      '<span class="best' + (v === null ? ' none' : '') + '">' + (v === null ? '还没玩过' : '最高 <b>' + v + '</b>') + '</span>' +
      '<button class="btn sm primary" data-play="' + g.id + '">▶ 启动</button>' +
      '</div></article>';
  }
  function renderGrid() {
    var list = GAMES.filter(function (g) { return activeCat === '全部' || g.cat === activeCat; });
    gridEl.innerHTML = list.map(cardHTML).join('') ||
      '<p class="tip" style="grid-column:1/-1">这个分类暂时没有游戏。</p>';
    $$('[data-play]', gridEl).forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        var g = findGame(b.getAttribute('data-play'));
        if (g) openGame(g);
      });
    });
    $$('[data-card]', gridEl).forEach(function (c) {
      c.addEventListener('click', function () {
        var g = findGame(c.getAttribute('data-card'));
        if (g) openGame(g);
      });
    });
  }
  function refreshCard(id) {
    var g = findGame(id);
    var c = $('[data-card="' + id + '"]', gridEl);
    if (!g || !c) return;
    var v = fmtBest(g), el = $('.best', c);
    el.innerHTML = v === null ? '还没玩过' : '最高 <b>' + v + '</b>';
    el.className = 'best' + (v === null ? ' none' : '');
  }
  function findGame(id) {
    for (var i = 0; i < GAMES.length; i++) if (GAMES[i].id === id) return GAMES[i];
    return null;
  }
  function renderFilters() {
    filtersEl.innerHTML = CATS.map(function (c) {
      return '<button class="chip' + (c === activeCat ? ' on' : '') + '" data-cat="' + c + '">' + c + '</button>';
    }).join('');
    $$('[data-cat]', filtersEl).forEach(function (b) {
      b.addEventListener('click', function () {
        activeCat = b.getAttribute('data-cat');
        sfx('click');
        renderFilters(); renderGrid();
      });
    });
  }
  function renderStats() {
    var played = Object.keys(store.data.bests).length;
    $('#statGames').textContent = GAMES.length;
    $('#statPlayed').textContent = played;
  }
  function renderRecords() {
    var el = $('#recordList');
    var rows = GAMES.filter(function (g) { return store.data.bests[g.id] !== undefined; })
      .map(function (g) { return g.emoji + ' ' + g.name + ' — ' + g.fmt(store.data.bests[g.id]); });
    el.innerHTML = rows.length ? rows.join('<br>') : '还没有成绩，先去玩一局。';
    $('#cntGames').textContent = GAMES.length;
  }

  /* ---------- 其他作品卡片跳转 ---------- */
  $$('[data-link]').forEach(function (c) {
    c.addEventListener('click', function () { window.location.href = c.getAttribute('data-link'); });
  });

  /* ---------- 音效开关 ---------- */
  function syncMute() {
    var txt = store.data.muted ? '🔇' : '🔊';
    $('#muteBtn').textContent = txt;
    $('#stageMute').textContent = txt;
  }
  function toggleMute() {
    store.data.muted = !store.data.muted;
    store.save(); syncMute();
    if (!store.data.muted) sfx('good');
  }
  $('#muteBtn').addEventListener('click', toggleMute);
  $('#stageMute').addEventListener('click', toggleMute);

  /* ---------- 随机开一局 ---------- */
  $('#randomBtn').addEventListener('click', function () {
    openGame(GAMES[rand(GAMES.length)]);
  });

  /* ---------- 首屏打字机 ---------- */
  (function typing() {
    var lines = [
      '我是章哲凡，叫我凡哥就行。',
      '这里有 7 款小游戏，随点随玩。',
      '挑一个，点启动，直接开打。'
    ];
    var el = $('#typing'), li = 0, ci = 0, del = false;
    function tick() {
      var text = lines[li];
      if (!del) {
        ci++;
        if (ci > text.length) { del = true; return setTimeout(tick, 1500); }
      } else {
        ci--;
        if (ci < 0) { del = false; li = (li + 1) % lines.length; ci = 0; return setTimeout(tick, 320); }
      }
      el.textContent = text.slice(0, ci);
      setTimeout(tick, del ? 42 : 105);
    }
    tick();
  })();

  /* ---------- 初始化 ---------- */
  $('#year').textContent = new Date().getFullYear();
  renderFilters();
  renderGrid();
  renderStats();
  renderRecords();
  syncMute();

  // 键盘无障碍：Esc 已处理；空链接防跳
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href="#"]');
    if (a) e.preventDefault();
  });
})();
</script>
</body>
