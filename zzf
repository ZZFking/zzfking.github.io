<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#06070f">
<title>凡哥主题空间 · 章哲凡的小游戏厅</title>
<meta name="description" content="章哲凡（凡哥）主题空间：一个页面收齐凡哥出品小游戏，点开即玩、免下载，最高分自动保存在本机。">
<meta name="author" content="章哲凡">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23ff7a18'/%3E%3Ctext x='32' y='45' font-size='38' text-anchor='middle' fill='%2306070f' font-family='sans-serif' font-weight='bold'%3E%E5%87%A1%3C/text%3E%3C/svg%3E">
<style>
/* ============ 基础 ============ */
*,*::before,*::after{box-sizing:border-box}
:root{
  --bg:#06070f;
  --text:#e9edf8;
  --dim:#8a93ab;
  --line:rgba(255,255,255,.10);
  --line-2:rgba(255,255,255,.18);
  --panel:rgba(255,255,255,.045);
  --o:#ff7a18;
  --c:#38bdf8;
  --p:#a855f7;
  --g:#22d3a7;
  --r:18px;
  --shell:1120px;
}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:"PingFang SC","Microsoft YaHei","Hiragino Sans GB","Noto Sans SC",system-ui,-apple-system,"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
body.locked{overflow:hidden}
h1,h2,h3,h4,p,ul,ol{margin:0}
ul,ol{padding:0;list-style:none}
button{font:inherit;color:inherit}
canvas{display:block}
.shell{width:100%;max-width:var(--shell);margin:0 auto;padding:0 20px}

/* 背景层 */
.bg{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.bg::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(900px 520px at 12% -8%,rgba(255,122,24,.22),transparent 60%),
    radial-gradient(820px 520px at 92% 4%,rgba(56,189,248,.18),transparent 62%),
    radial-gradient(900px 620px at 50% 108%,rgba(168,85,247,.20),transparent 64%);
}
.bg::after{
  content:"";position:absolute;inset:0;opacity:.35;
  background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);
  background-size:54px 54px;
  mask-image:radial-gradient(circle at 50% 30%,#000 20%,transparent 78%);
  -webkit-mask-image:radial-gradient(circle at 50% 30%,#000 20%,transparent 78%);
}
.bg .orb{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;animation:float 16s ease-in-out infinite}
.bg .orb.a{width:340px;height:340px;left:-80px;top:24%;background:rgba(255,122,24,.5)}
.bg .orb.b{width:300px;height:300px;right:-60px;top:56%;background:rgba(56,189,248,.42);animation-delay:-5s}
.bg .orb.c{width:260px;height:260px;left:44%;top:78%;background:rgba(168,85,247,.42);animation-delay:-9s}
@keyframes float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-38px,0)}}

/* ============ 顶栏 ============ */
.topbar{position:sticky;top:0;z-index:40;backdrop-filter:blur(14px);background:linear-gradient(180deg,rgba(6,7,15,.9),rgba(6,7,15,.55));border-bottom:1px solid var(--line)}
.topbar-inner{display:flex;align-items:center;gap:16px;height:66px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit}
.brand-mark{
  width:42px;height:42px;flex:0 0 42px;display:grid;place-items:center;border-radius:13px;
  background:linear-gradient(140deg,var(--o),#ff4d6d 55%,var(--p));
  color:#0a0b12;font-weight:900;font-size:22px;box-shadow:0 8px 24px rgba(255,122,24,.35)
}
.brand-text b{display:block;font-size:16px;letter-spacing:.5px}
.brand-text em{display:block;font-style:normal;font-size:11.5px;color:var(--dim);letter-spacing:1.6px;text-transform:uppercase}
.nav{margin-left:auto;display:flex;align-items:center;gap:6px}
.nav a{color:var(--dim);text-decoration:none;font-size:14px;padding:9px 13px;border-radius:11px;transition:.2s}
.nav a:hover{color:var(--text);background:var(--panel)}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  border:1px solid var(--line-2);background:var(--panel);color:var(--text);
  padding:11px 18px;border-radius:13px;cursor:pointer;font-size:14px;font-weight:600;
  transition:transform .16s,box-shadow .2s,background .2s,border-color .2s;white-space:nowrap
}
.btn:hover{transform:translateY(-2px);background:rgba(255,255,255,.09)}
.btn:active{transform:translateY(0)}
.btn.primary{background:linear-gradient(120deg,var(--o),#ff4d6d);border-color:transparent;color:#100508;box-shadow:0 10px 30px rgba(255,90,60,.32)}
.btn.primary:hover{box-shadow:0 14px 38px rgba(255,90,60,.45)}
.btn.ghost{background:transparent}
.btn.sm{padding:8px 13px;font-size:13px;border-radius:11px}
.btn.lg{padding:15px 26px;font-size:16px;border-radius:15px}
.chip{
  border:1px solid var(--line);background:var(--panel);color:var(--dim);
  padding:7px 15px;border-radius:999px;font-size:13px;cursor:pointer;transition:.2s
}
.chip:hover{color:var(--text)}
.chip.on{background:linear-gradient(120deg,rgba(255,122,24,.9),rgba(255,77,109,.9));color:#12060a;border-color:transparent;font-weight:700}
.icon-btn{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;border:1px solid var(--line);background:var(--panel);cursor:pointer;font-size:17px;transition:.2s}
.icon-btn:hover{background:rgba(255,255,255,.1)}

/* ============ 首屏 ============ */
.hero{padding:74px 0 40px;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
.pill{display:inline-flex;align-items:center;gap:9px;font-size:13px;color:#ffd9c0;border:1px solid rgba(255,122,24,.34);background:rgba(255,122,24,.11);padding:8px 15px;border-radius:999px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--g);box-shadow:0 0 0 4px rgba(34,211,167,.16);animation:pulse 2s infinite}
@keyframes pulse{50%{box-shadow:0 0 0 9px rgba(34,211,167,0)}}
.hero h1{font-size:clamp(40px,6.4vw,68px);line-height:1.04;margin:20px 0 0;letter-spacing:-1px}
.hero h1 .grad{background:linear-gradient(100deg,#ffb35c,var(--o) 38%,#ff4d6d 66%,var(--p));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero .sub{margin-top:16px;font-size:clamp(15px,2.2vw,18px);color:#c8d0e4;min-height:28px}
.hero .sub b{color:var(--o)}
.caret{display:inline-block;width:9px;height:19px;background:var(--o);vertical-align:-3px;margin-left:3px;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
.hero .desc{margin-top:14px;color:var(--dim);line-height:1.85;font-size:14.5px;max-width:600px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.hero-meta{display:flex;gap:30px;margin-top:34px;flex-wrap:wrap}
.hero-meta li b{display:block;font-size:26px;background:linear-gradient(120deg,#fff,#9fb0d0);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-meta li span{font-size:12.5px;color:var(--dim)}
.hero-art{position:relative;display:grid;place-items:center;min-height:330px}
.orbit{position:relative;width:min(330px,74vw);aspect-ratio:1;display:grid;place-items:center}
.ring{position:absolute;inset:0;border-radius:50%;border:1px dashed rgba(255,255,255,.14);animation:spin 26s linear infinite}
.ring.r2{inset:12%;border-style:solid;border-color:rgba(255,122,24,.24);animation-duration:18s;animation-direction:reverse}
.ring.r3{inset:24%;border-color:rgba(56,189,248,.22);animation-duration:12s}
@keyframes spin{to{transform:rotate(360deg)}}
.core{position:relative;width:56%;aspect-ratio:1;border-radius:34px;display:grid;place-items:center;
  background:linear-gradient(150deg,rgba(255,122,24,.9),rgba(168,85,247,.85));
  box-shadow:0 26px 70px rgba(255,90,60,.35),inset 0 0 0 1px rgba(255,255,255,.22)}
.core .face{font-size:clamp(44px,11vw,74px);font-weight:900;color:#0d0710;letter-spacing:2px}
.core .plate{position:absolute;bottom:-16px;white-space:nowrap;font-size:12.5px;padding:7px 14px;border-radius:999px;background:rgba(8,10,20,.92);border:1px solid var(--line-2);color:var(--dim)}
.core .plate b{color:var(--o)}
.sat{position:absolute;width:46px;height:46px;display:grid;place-items:center;border-radius:14px;font-size:22px;
  background:rgba(10,12,22,.9);border:1px solid var(--line-2);box-shadow:0 12px 30px rgba(0,0,0,.5);animation:float 7s ease-in-out infinite}
.sat.s1{top:2%;left:6%}
.sat.s2{top:16%;right:0;animation-delay:-1.6s}
.sat.s3{bottom:12%;left:0;animation-delay:-3.2s}
.sat.s4{bottom:0;right:10%;animation-delay:-4.8s}

/* ============ 区块 ============ */
.section{padding:54px 0}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:26px}
.eyebrow{font-size:11.5px;letter-spacing:3px;color:var(--o);font-weight:700}
.section-title{font-size:clamp(24px,3.6vw,34px);margin-top:8px;letter-spacing:-.5px}
.section-note{color:var(--dim);font-size:13.5px;max-width:430px;line-height:1.75}
.filters{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:22px}

/* ============ 游戏卡 ============ */
.game-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(268px,1fr));gap:18px}
.card{
  position:relative;border-radius:var(--r);border:1px solid var(--line);background:linear-gradient(170deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
  padding:20px;display:flex;flex-direction:column;gap:13px;overflow:hidden;
  transition:transform .22s,border-color .22s,box-shadow .3s;cursor:pointer
}
.card::after{content:"";position:absolute;inset:-40% 55% 60% -40%;background:radial-gradient(circle,var(--glow,rgba(255,122,24,.3)),transparent 68%);opacity:0;transition:opacity .35s;pointer-events:none}
.card:hover{transform:translateY(-7px);border-color:var(--line-2);box-shadow:0 26px 60px rgba(0,0,0,.55)}
.card:hover::after{opacity:1}
.card-top{display:flex;align-items:center;gap:14px}
.card-emoji{width:56px;height:56px;flex:0 0 56px;display:grid;place-items:center;font-size:28px;border-radius:16px;
  background:rgba(255,255,255,.07);border:1px solid var(--line)}
.card-name{font-size:17.5px;font-weight:700;letter-spacing:.3px}
.card-cat{font-size:11.5px;color:var(--dim);margin-top:4px;display:flex;align-items:center;gap:8px}
.stars{color:var(--o);letter-spacing:1px}
.card-desc{color:var(--dim);font-size:13.5px;line-height:1.75;flex:1}
.card-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--line);padding-top:13px}
.best{font-size:12.5px;color:var(--dim)}
.best b{color:var(--g);font-size:14px}
.best.none b{color:#5c6479}

/* ============ 页脚 ============ */
.footer{border-top:1px solid var(--line);margin-top:40px;padding:34px 0;background:rgba(0,0,0,.24)}
.footer-inner{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.footer-brand{display:flex;align-items:center;gap:12px}
.footer-brand .brand-mark{width:36px;height:36px;flex:0 0 36px;font-size:18px;border-radius:11px}
.footer-brand b{display:block;font-size:14.5px}
.footer-brand em{font-style:normal;font-size:12px;color:var(--dim)}
.footer-copy{color:#6a7288;font-size:12.5px;line-height:1.8;text-align:right}
.footer-links{display:flex;gap:18px;flex-wrap:wrap}
.footer-links a{color:var(--dim);text-decoration:none;font-size:13px}
.footer-links a:hover{color:var(--o)}

/* ============ 启动舞台 ============ */
.stage{position:fixed;inset:0;z-index:80;display:flex;flex-direction:column;padding:14px 16px 22px;
  background:radial-gradient(900px 600px at 50% -10%,rgba(255,122,24,.16),transparent 62%),rgba(4,5,12,.93);
  backdrop-filter:blur(16px);overflow:auto;animation:fade .25s ease}
@keyframes fade{from{opacity:0}to{opacity:1}}
.stage[hidden]{display:none}
.stage-bar{display:flex;align-items:center;gap:12px;width:100%;max-width:860px;margin:0 auto 16px;
  padding:11px 14px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.045)}
.stage-bar .t{font-weight:700;font-size:15.5px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stage-bar .b{font-size:12.5px;color:var(--dim);white-space:nowrap}
.stage-bar .b b{color:var(--g)}
.stage-body{margin:auto 0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;width:100%;padding:6px 0 10px}
.game{display:flex;flex-direction:column;align-items:center;gap:14px;width:100%;animation:rise .3s ease}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.hud{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.hud-item{font-size:12.5px;color:var(--dim);border:1px solid var(--line);background:var(--panel);padding:8px 14px;border-radius:11px}
.hud-item b{color:var(--text);font-size:15px;margin-left:4px;font-variant-numeric:tabular-nums}
.tip{font-size:12.5px;color:#6d768c;text-align:center;max-width:520px;line-height:1.7}
.cv-wrap{display:flex;justify-content:center;width:100%}
.cv{width:100%;max-width:520px;height:auto;border-radius:15px;background:#070a14;border:1px solid var(--line-2);
  box-shadow:0 24px 70px rgba(0,0,0,.6);touch-action:none}
.dpad{display:grid;grid-template-columns:repeat(3,54px);grid-template-rows:repeat(2,54px);gap:8px;justify-content:center}
.dpad button{border-radius:14px;border:1px solid var(--line-2);background:var(--panel);font-size:19px;cursor:pointer;transition:.15s;user-select:none}
.dpad button:active{background:rgba(255,122,24,.35);transform:scale(.94)}
.dpad [data-dir=up]{grid-area:1/2}
.dpad [data-dir=left]{grid-area:2/1}
.dpad [data-dir=down]{grid-area:2/2}
.dpad [data-dir=right]{grid-area:2/3}

/* 启动动画 */
.boot{display:flex;flex-direction:column;align-items:center;gap:16px;padding:40px 0}
.boot-logo{font-size:64px;animation:pop .6s ease}
@keyframes pop{from{transform:scale(.5);opacity:0}to{transform:scale(1);opacity:1}}
.boot-text{font-size:15px;color:var(--dim);letter-spacing:1px}
.boot-bar{width:220px;height:5px;border-radius:999px;background:rgba(255,255,255,.1);overflow:hidden}
.boot-bar i{display:block;height:100%;width:40%;border-radius:999px;background:linear-gradient(90deg,var(--o),var(--p));animation:load .55s ease forwards}
@keyframes load{from{width:6%}to{width:100%}}

/* 结算层 */
.gover{position:fixed;inset:0;z-index:95;display:grid;place-items:center;background:rgba(4,5,12,.66);backdrop-filter:blur(6px);animation:fade .2s}
.gover-card{width:min(360px,90vw);text-align:center;border:1px solid var(--line-2);border-radius:22px;padding:30px 24px;
  background:linear-gradient(170deg,rgba(28,20,40,.96),rgba(10,11,20,.98));box-shadow:0 30px 80px rgba(0,0,0,.7)}
.gover-card h3{font-size:23px;margin-bottom:10px}
.gover-card p{color:var(--dim);font-size:14px;line-height:1.8}
.gover-card p b{color:var(--o);font-size:19px}
.gover-actions{display:flex;gap:10px;justify-content:center;margin-top:22px;flex-wrap:wrap}

/* 2048 */
.g2048{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;width:min(430px,90vw);aspect-ratio:1;
  padding:10px;border-radius:18px;background:rgba(255,255,255,.05);border:1px solid var(--line);touch-action:none}
.t2048{display:grid;place-items:center;border-radius:12px;font-weight:800;font-size:clamp(15px,4.6vw,26px);
  background:rgba(255,255,255,.05);color:#0e0b16;transition:transform .12s}
.t2048[data-v="0"]{background:rgba(255,255,255,.045);color:transparent}
.t2048[data-v="2"]{background:#e8ecf6}
.t2048[data-v="4"]{background:#ffdcae}
.t2048[data-v="8"]{background:linear-gradient(140deg,#ffb35c,#ff8a3d)}
.t2048[data-v="16"]{background:linear-gradient(140deg,#ff9a4d,#ff5f3d)}
.t2048[data-v="32"]{background:linear-gradient(140deg,#ff6b6b,#ff3d6e);color:#fff}
.t2048[data-v="64"]{background:linear-gradient(140deg,#ff3d6e,#c026d3);color:#fff}
.t2048[data-v="128"]{background:linear-gradient(140deg,#38bdf8,#0ea5e9);color:#fff}
.t2048[data-v="256"]{background:linear-gradient(140deg,#22d3a7,#0d9488);color:#fff}
.t2048[data-v="512"]{background:linear-gradient(140deg,#a855f7,#7c3aed);color:#fff}
.t2048[data-v="1024"]{background:linear-gradient(140deg,#facc15,#f97316);color:#fff}
.t2048[data-v="2048"]{background:linear-gradient(140deg,#fde047,#f43f5e);color:#fff;box-shadow:0 0 0 3px rgba(253,224,71,.5)}
.tile-new{animation:pop .18s ease}

/* 记忆翻牌 */
.mem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;width:min(470px,90vw)}
.mem-card{aspect-ratio:1;perspective:900px;background:none;border:0;padding:0;cursor:pointer}
.mem-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .38s cubic-bezier(.4,1.4,.5,1)}
.mem-card.flip .mem-inner{transform:rotateY(180deg)}
.mem-face{position:absolute;inset:0;display:grid;place-items:center;border-radius:15px;backface-visibility:hidden;font-size:clamp(22px,6.5vw,34px)}
.mem-front{background:linear-gradient(150deg,rgba(255,122,24,.26),rgba(168,85,247,.26));border:1px solid var(--line-2);color:rgba(255,255,255,.34);font-weight:900;font-size:19px}
.mem-back{background:rgba(255,255,255,.08);border:1px solid var(--line-2);transform:rotateY(180deg)}
.mem-card.done .mem-back{border-color:var(--g);box-shadow:0 0 0 2px rgba(34,211,167,.35),0 0 26px rgba(34,211,167,.25)}

/* 扫雷 */
.ms-grid{display:grid;grid-template-columns:repeat(9,1fr);gap:5px;width:min(410px,88vw);padding:10px;border-radius:16px;
  background:rgba(255,255,255,.05);border:1px solid var(--line)}
.ms-cell{aspect-ratio:1;display:grid;place-items:center;border-radius:9px;border:1px solid var(--line);background:rgba(255,255,255,.08);
  font-weight:800;font-size:clamp(12px,3.4vw,17px);cursor:pointer;transition:.12s;padding:0;user-select:none}
.ms-cell:hover{background:rgba(255,255,255,.16)}
.ms-cell.open{background:rgba(255,255,255,.03);cursor:default;border-color:rgba(255,255,255,.06)}
.ms-cell.flag{background:rgba(255,122,24,.22)}
.ms-cell.boom{background:rgba(244,63,94,.55)}
.n1{color:#60a5fa}.n2{color:#34d399}.n3{color:#f87171}.n4{color:#a78bfa}
.n5{color:#fbbf24}.n6{color:#22d3ee}.n7{color:#e879f9}.n8{color:#94a3b8}

/* 提示条 */
.toast{position:fixed;left:50%;bottom:34px;transform:translateX(-50%);z-index:120;
  padding:13px 22px;border-radius:14px;font-size:14px;font-weight:600;
  background:linear-gradient(120deg,rgba(255,122,24,.96),rgba(255,77,109,.96));color:#150406;
  box-shadow:0 18px 46px rgba(255,90,60,.42);animation:up .3s ease}
@keyframes up{from{opacity:0;transform:translate(-50%,18px)}to{opacity:1;transform:translate(-50%,0)}}
.toast.out{opacity:0;transition:opacity .35s}

@media (max-width:900px){
  .hero{grid-template-columns:1fr;padding-top:44px;gap:26px}
  .hero-art{order:-1;min-height:250px}
  .nav{display:none}
  .footer-copy{text-align:left}
}
@media (max-width:520px){
  .mem-grid{grid-template-columns:repeat(3,1fr)}
  .shell{padding:0 15px}
  .stage-bar .b{display:none}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms !important;transition-duration:.01ms !important}
}
</style>
</head>
<body>
<div class="bg" aria-hidden="true">
  <span class="orb a"></span><span class="orb b"></span><span class="orb c"></span>
</div>

<header class="topbar">
  <div class="shell topbar-inner">
    <a class="brand" href="#top">
      <span class="brand-mark">凡</span>
      <span class="brand-text"><b>凡哥主题空间</b><em>Fange Arcade</em></span>
    </a>
    <nav class="nav">
      <a href="#games">游戏厅</a>
